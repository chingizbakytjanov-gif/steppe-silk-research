{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.steppesilk.com"
        }
      ],
      "destination": "https://steppesilk.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "steppe-silk-research.vercel.app"
        }
      ],
      "destination": "https://steppesilk.com/:path*",
      "permanent": true
    },
    {
      "source": "/companies.html",
      "destination": "/research.html#companies",
      "permanent": true
    },
    {
      "source": "/trade.html",
      "destination": "/research.html#trade",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/about.html#contact",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(photos|flags|logos)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
